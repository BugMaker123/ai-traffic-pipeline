# 大模型配置 (支持 OpenAI / DeepSeek / 阿里通义千问 / 本地 Ollama 等兼容 OpenAI 格式的接口)
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Pexels 免费素材库 API (https://www.pexels.com/api/ - 可选，未配置时自动启用高质感动态粒子与本地素材保底)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay 免费 4K/1080P 实拍视频与图库 API (https://pixabay.com/api/docs/ - 免费注册即拿 Key，大幅提升真实视频命中率)
PIXABAY_API_KEY=your_pixabay_api_key_here

# TTS 语音配置
DEFAULT_TTS_VOICE=zh-CN-YunxiNeural
DEFAULT_TTS_RATE=+0%
DEFAULT_TTS_VOLUME=+0%
DEFAULT_TTS_PITCH=-2Hz

# 视频输出配置
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Web 任务与产物管理
MAX_RENDER_JOBS=1
TTS_CONCURRENCY=3
MEDIA_FETCH_CONCURRENCY=3
MAX_SCENES=12
OUTPUT_RETENTION_HOURS=72

# Web 服务网络配置
WEB_HOST=127.0.0.1
WEB_PORT=9000
